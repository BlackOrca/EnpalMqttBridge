# Kopieren nach ".env" und an die eigene Umgebung anpassen.

# URL der Enpal-Box (deviceMessages-Seite)
ENPAL_URL=http://<ENPAL_BOX_IP>/deviceMessages

# MQTT-Broker
MQTT_HOST=<MQTT_BROKER_HOST>
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=enpal-mqtt-bridge
MQTT_TOPIC_PREFIX=enpal

# Wie oft der aktuelle Zustand der (bereits offenen) Browser-Seite
# ausgelesen und veröffentlicht wird.
POLL_INTERVAL_SECONDS=20

# Wartezeit vor einem Neustart der kompletten Sitzung (neuer Browser,
# neue Verbindung), falls z.B. die Blazor-Verbindung abbricht.
RESTART_DELAY_SECONDS=15
