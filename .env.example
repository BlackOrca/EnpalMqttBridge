# Kopieren nach ".env" und an die eigene Umgebung anpassen.

# Basis-URL der Enpal-Box (gelesen wird immer die Seite /deviceMessages,
# ein Pfad wie das fruehere /collector wird ignoriert)
ENPAL_URL=http://<ENPAL_BOX_IP>

# MQTT-Broker
MQTT_HOST=<MQTT_BROKER_HOST>
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=enpal-mqtt-bridge
MQTT_TOPIC_PREFIX=enpal

# Nach wie vielen Sekunden ein haengender MQTT-Connect/Publish (z.B. weil
# der Broker nicht erreichbar ist, aber die Verbindung auch nicht sauber
# ablehnt) abgebrochen wird, damit die Bridge neu verbindet statt endlos
# haengen zu bleiben.
MQTT_OPERATION_TIMEOUT_SECONDS=20

# Wie oft der aktuelle Zustand der (bereits offenen) Browser-Seite
# ausgelesen und veröffentlicht wird.
POLL_INTERVAL_SECONDS=20

# Wartezeit vor einem Neustart der kompletten Sitzung (neuer Browser,
# neue Verbindung), falls z.B. die Blazor-Verbindung abbricht.
RESTART_DELAY_SECONDS=15

# Home-Assistant-MQTT-Discovery: veroeffentlicht pro Sensor eine retained
# Config-Nachricht unter "<HA_DISCOVERY_PREFIX>/sensor/<MQTT_CLIENT_ID>/...",
# damit z.B. das HA-Discovery-Modul in Symcon die Objekte automatisch anlegt.
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
